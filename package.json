{
  "name": "@rozsival/pantheon",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal, configurable baseline for a headless Ubuntu Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/rozsival/pantheon.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:cli": "bashly generate",
    "check": "pnpx concurrently --kill-others-on-fail --prefix-colors auto \"pnpm run check:misc\" \"pnpm run check:sh\"",
    "check:misc": "prettier --check .",
    "check:sh": "shellcheck bin/pantheon release/*.sh",
    "fix": "pnpm run format",
    "format": "prettier --write .",
    "postinstall": "is-ci || lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "is-ci": "4.1.0",
    "lefthook": "2.2.3",
    "prettier": "3.10.1",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-plugin-sh": "0.20.2",
    "prettier-plugin-toml": "4.1.0"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.x"
  }
}
