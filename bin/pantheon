  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      --allowed-user | -u)
        shift
        if [[ $# -eq 0 ]]; then

          return
        fi
        shift
        completion_blocked_flags["--allowed-user"]=1

        ;;
      *)
        return
        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --allowed-user "$completion_current" --allowed-user -u
  fi

}

pantheon_update_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      *)
        if [[ $completion_arg_index -ge 1 ]]; then
          return
        fi
        completion_arg_index=$((completion_arg_index + 1))
        shift

        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

pantheon_install_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      *)
        return
        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

pantheon_completions_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      *)
        if [[ $completion_arg_index -ge 1 ]]; then
          return
        fi
        completion_arg_index=$((completion_arg_index + 1))
        shift

        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
      0)
        local -a completion_values=(
          "bash"
          "zsh"
        )
        completion_candidates "$completion_current" "${completion_values[@]}"
        ;;
    esac
  fi

}

before_hook() {
  :

}

after_hook() {
  :

}

initialize() {
  declare -g version="1.0.0"
  set -euo pipefail

  PANTHEON_REPO_ROOT="$(pantheon_repo_root)"
  declare -gr PANTHEON_REPO_ROOT
  declare -gr PANTHEON_CLI_BIN="$PANTHEON_REPO_ROOT/bin/pantheon"
  declare -gr PANTHEON_SSHD_CONFIG="/etc/ssh/sshd_config"
  declare -gr PANTHEON_SSHD_CONFIG_DIR="/etc/ssh/sshd_config.d"
  declare -gr PANTHEON_FAIL2BAN_JAIL="/etc/fail2ban/jail.local"
  declare -gr PANTHEON_GITHUB_REPO="rozsival/pantheon"
  declare -gr PANTHEON_RELEASE_ASSET="pantheon.tar.gz"
  declare -gr PANTHEON_INSTALL_COMMAND="curl -fsSL https://github.com/$PANTHEON_GITHUB_REPO/releases/latest/download/install.sh | bash"

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"
  before_hook

  case "$action" in
    "setup") pantheon_setup_command ;;
    "setup all") pantheon_setup_all_command ;;
    "setup init") pantheon_setup_init_command ;;
    "setup packages") pantheon_setup_packages_command ;;
    "setup docker") pantheon_setup_docker_command ;;
    "setup tailscale") pantheon_setup_tailscale_command ;;
    "setup ssh") pantheon_setup_ssh_command ;;
    "setup ufw") pantheon_setup_ufw_command ;;
    "setup fail2ban") pantheon_setup_fail2ban_command ;;
    "setup brew") pantheon_setup_brew_command ;;
    "setup shell") pantheon_setup_shell_command ;;
    "update") pantheon_update_command ;;
    "install") pantheon_install_command ;;
    "completions") pantheon_completions_command ;;
  esac

  after_hook
}

start() {
  if [[ ${1:-} == "__complete" ]]; then
    completion_run "${@:2}"
    return
  fi

  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"
