pantheon_install_usage() {
  if [[ -n $long_usage ]]; then
    printf "pantheon install\n\n"
    printf "  Put pantheon on your PATH, with bash completion\n  \n  Symlinks ~/.local/bin/pantheon onto this install's bin/pantheon and writes\n  ~/.local/share/bash-completion/completions/pantheon, which bash-completion\n  lazy-loads. Idempotent; then checks that a fresh login shell finds both.\n  Run it as yourself, not with sudo; 'setup all' runs it for the allowed user.\n\n"
  else
    printf "pantheon install - Put pantheon on your PATH, with bash completion\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  pantheon install\n"
