normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

pantheon_repo_root() {
  # From the real file: `install` reaches bin/pantheon through a symlink in
  # ~/.local/bin, and `__complete` runs from any directory.
  (cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
}
pantheon_resolve_option() {
  local flag_name="$1"
  local env_name="$2"
  local default_value="${3:-}"

  if [[ -n ${args[$flag_name]+x} && -n ${args[$flag_name]} ]]; then
    printf '%s\n' "${args[$flag_name]}"
    return 0
  fi

  # Indirect expansion rather than 'printenv': these are plain shell globals set
  # by earlier resolution and by the 'setup all' prompts, and printenv only sees
  # *exported* variables. It returned an empty string for every unexported one,
  # so a resolved value silently erased itself on the next resolution pass.
  # An empty value falls through to the default instead of winning.
  if [[ -n "${!env_name:-}" ]]; then
    printf '%s\n' "${!env_name}"
    return 0
  fi

  printf '%s\n' "$default_value"
}
pantheon_require_root() {
  [[ $EUID -eq 0 ]] || pantheon_log_error "This command must be run as root (use sudo)."
}
pantheon_confirm() {
  [[ "${PANTHEON_CONFIRMED:-0}" == "1" ]] && return 0
  local message="${1:-Are you sure you want to continue?}"
  echo -e "\033[1;33m[CONFIRM]\033[0m $message"
  read -r -p "         Proceed? (y/N): " reply
  [[ "$reply" =~ ^[Yy]$ ]] || {
    pantheon_log_warn "Aborted."
    exit 0
  }
}

# `pantheon` by name: a symlink in ~/.local/bin onto this install's bin/pantheon, plus bash completion where
# bash-completion's lazy loader looks for it
# (~/.local/share/bash-completion/completions/<command>), so it costs nothing
# until the first <TAB> after `pantheon`.

pantheon_install_link() { printf '%s\n' "$HOME/.local/bin/pantheon"; }
pantheon_install_completion_file() {
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions/pantheon"
}

# The completion file's exact content. The bashly script only forwards each
# <TAB> to `pantheon __complete`, so it holds no command list and a re-run
# is needed only when bashly's own completion function changes.
pantheon_install_completion_script() {
  # shellcheck disable=SC2016 # literal backticks
  printf '# Written by `pantheon install` from `pantheon completions bash`: re-run it, never edit.\n'
  send_completions bash
}

# How a fresh login shell sees `pantheon` - what a new SSH session gets,
# independent of the PATH this process inherited (`setup all` runs install
# through sudo, whose PATH has no ~/.local/bin). Prints `path=<resolved>` and,
# for a bash login shell, `loader=yes` when bash-completion's lazy loader is
# defined.
pantheon_install_fresh_shell() {
  local shell="${SHELL:-/bin/bash}"
  # shellcheck disable=SC2016 # expands in the probed shell
  env -i HOME="$HOME" USER="${USER:-}" LOGNAME="${LOGNAME:-${USER:-}}" SHELL="$shell" TERM=dumb \
    PATH=/usr/bin:/bin:/usr/sbin:/sbin "$shell" -lic \
    'printf "path=%s\n" "$(command -v pantheon)"
     [ -n "${BASH_VERSION:-}" ] && declare -F _comp_load __load_completion >/dev/null && echo loader=yes
     exit 0' </dev/null 2>/dev/null || true
}

pantheon_install_completion_hint() {
  if [[ "$(uname -s)" == Darwin ]]; then
    # shellcheck disable=SC2016 # a command for the user to run
    echo 'brew install bash-completion@2, then source "$(brew --prefix)/etc/profile.d/bash_completion.sh" from ~/.bashrc'
  else
    echo "sudo apt-get install -y bash-completion, then source /usr/share/bash-completion/bash_completion from ~/.bashrc (Ubuntu's default ~/.bashrc does)"
  fi
}

# Reports every check before failing, so one run lists every fix.
pantheon_install_checks() {
  local link file probe resolved
  local failures=0
  link="$(pantheon_install_link)"
  file="$(pantheon_install_completion_file)"

  if [[ -L "$link" && "$(readlink "$link")" == "$PANTHEON_CLI_BIN" ]]; then
    pantheon_log_success "$link -> $PANTHEON_CLI_BIN"
  else
    pantheon_log_warn "$link is not a symlink onto $PANTHEON_CLI_BIN."
    failures=$((failures + 1))
  fi

  if [[ -f "$file" ]] && cmp -s "$file" <(pantheon_install_completion_script); then
    pantheon_log_success "Bash completion at $file."
  else
    pantheon_log_warn "Bash completion at $file is missing or stale."
    failures=$((failures + 1))
  fi

  probe="$(pantheon_install_fresh_shell)"
  resolved="$(sed -n 's/^path=//p' <<<"$probe")"
  if [[ "$resolved" == "$link" ]]; then
    pantheon_log_success "A login shell (${SHELL:-/bin/bash}) resolves pantheon to $link."
  elif [[ -z "$resolved" ]]; then
    # shellcheck disable=SC2016 # literal $HOME/$PATH in the hint
    pantheon_log_warn "A login shell (${SHELL:-/bin/bash}) does not find pantheon - add ~/.local/bin to its PATH: export PATH=\"\$HOME/.local/bin:\$PATH\""
    failures=$((failures + 1))
  else
    pantheon_log_warn "A login shell resolves pantheon to $resolved, ahead of $link - remove it or put ~/.local/bin first on the PATH."
    failures=$((failures + 1))
  fi

  if [[ "${SHELL:-/bin/bash}" != */bash ]]; then
    pantheon_log_info "Login shell $SHELL is not bash: completion is installed for bash only - for zsh, put 'source <(pantheon completions zsh)' in ~/.zshrc after compinit."
  elif grep -qx 'loader=yes' <<<"$probe"; then
    pantheon_log_success 'A login shell loads bash-completion, which lazy-loads pantheon completion.'
  else
    pantheon_log_warn "A login shell does not load bash-completion, so pantheon completion never loads - $(pantheon_install_completion_hint)."
    failures=$((failures + 1))
  fi

  ((failures == 0)) || pantheon_log_error "$failures check(s) failed: fix them, then re-run $PANTHEON_CLI_BIN install."
}

pantheon_log_info() {
  echo -e "\033[0;34m[INFO]\033[0m  $*"
}
pantheon_log_success() {
  echo -e "\033[0;32m[OK]\033[0m    $*"
}
pantheon_log_warn() {
  echo -e "\033[1;33m[WARN]\033[0m  $*"
}
pantheon_log_error() {
  echo -e "\033[0;31m[ERROR]\033[0m $*" >&2
  exit 1
}

pantheon_current_timezone() {
  timedatectl show -p Timezone --value 2>/dev/null || true
}
pantheon_resolve_setup_context() {
  declare -g PANTHEON_SERVER_NAME
  declare -g PANTHEON_ALLOWED_USER
  declare -g PANTHEON_SSH_PORT
  declare -g PANTHEON_TIMEZONE
  declare -g PANTHEON_LVM_DEVICE
  declare -g PANTHEON_ACTIONS_FILE

  PANTHEON_SERVER_NAME="$(pantheon_resolve_option '--server-name' PANTHEON_SERVER_NAME "$HOSTNAME")"
  # Every setup step calls pantheon_require_root, so $USER is always 'root' here
  # and never the human being configured. sudo records the real account in
  # SUDO_USER; a direct root login has no record of it and must pass the flag.
  PANTHEON_ALLOWED_USER="$(pantheon_resolve_option '--allowed-user' PANTHEON_ALLOWED_USER "${SUDO_USER:-}")"
  PANTHEON_SSH_PORT="$(pantheon_resolve_option '--ssh-port' PANTHEON_SSH_PORT '2222')"
  # The zone the host already has, so a re-run never moves the clock elsewhere
  # unless a zone is asked for explicitly.
  PANTHEON_TIMEZONE="$(pantheon_resolve_option '--timezone' PANTHEON_TIMEZONE "$(pantheon_current_timezone)")"
  PANTHEON_LVM_DEVICE="$(pantheon_resolve_option '--lvm-device' PANTHEON_LVM_DEVICE '/dev/ubuntu-vg/ubuntu-lv')"
  PANTHEON_ACTIONS_FILE="/tmp/${PANTHEON_SERVER_NAME}_actions"

  if [[ -z "$PANTHEON_ALLOWED_USER" ]]; then
    pantheon_log_error "Could not detect which user to configure. Run the CLI with 'sudo' from your own account, or pass --allowed-user <name>."
  fi

  # 'setup ssh' writes PermitRootLogin no together with AllowUsers, and 'setup
  # ufw' then closes everything but that port. A wrong name here locks every
  # account out of the host on the next reboot, so both cases fail up front.
  if [[ "$PANTHEON_ALLOWED_USER" == 'root' ]]; then
    pantheon_log_error "'root' cannot be the allowed user: 'setup ssh' sets PermitRootLogin no and AllowUsers root, which would lock you out. Pass --allowed-user <name>."
  fi

  if ! id -u "$PANTHEON_ALLOWED_USER" >/dev/null 2>&1; then
    pantheon_log_error "User '${PANTHEON_ALLOWED_USER}' does not exist on this host: 'setup ssh' would restrict AllowUsers to it and lock you out."
  fi
}
pantheon_ensure_actions_file() {
  mkdir -p "$(dirname "$PANTHEON_ACTIONS_FILE")"
  [[ -f "$PANTHEON_ACTIONS_FILE" ]] || touch "$PANTHEON_ACTIONS_FILE"
}
pantheon_register_action() {
  pantheon_ensure_actions_file
  printf '%s\n' "$*" >>"$PANTHEON_ACTIONS_FILE"
}
pantheon_register_bashrc_entry() {
  local label="$1"
  local command="$2"
  local user_name="${3:-$PANTHEON_ALLOWED_USER}"
  local bashrc="/home/$user_name/.bashrc"

  if ! grep -qF "$command" "$bashrc"; then
    pantheon_log_info "Adding $label to $bashrc..."
    printf '\n# %s\n%s\n' "$label" "$command" >>"$bashrc"
    chown "$user_name:$user_name" "$bashrc"
  fi
}
pantheon_prepare_setup_step() {
  local message="$1"
  pantheon_resolve_setup_context
  pantheon_require_root
  pantheon_confirm "$message"
  pantheon_ensure_actions_file

  # Every setup step runs apt-get unattended. Without this, dpkg conffile
  # prompts and needrestart's DPkg::Post-Invoke hook (a ubuntu-server
  # recommend, which branches on this variable) open dialogs that block the
  # run on a terminal nobody is watching.
  export DEBIAN_FRONTEND=noninteractive
}
pantheon_setup_step_label() {
  case "$1" in
  init) echo 'Storage and timezone' ;;
  packages) echo 'Packages' ;;
  docker) echo 'Docker' ;;
  tailscale) echo 'Tailscale' ;;
  ssh) echo 'SSH' ;;
  ufw) echo 'UFW' ;;
  fail2ban) echo 'fail2ban' ;;
  brew) echo 'Homebrew (extra)' ;;
  shell) echo 'Shell (extra)' ;;
  *) echo "$1" ;;
  esac
}
# Lists the steps that ran, so the summary never claims a step that was skipped.
pantheon_print_setup_summary() {
  local step
  local -i index=1

  echo ''
  echo -e "\033[0;32m🏛️  ${PANTHEON_SERVER_NAME} setup complete\033[0m"
  for step in "$@"; do
    printf "\033[0;32m   %2d. %s\033[0m\n" "$index" "$(pantheon_setup_step_label "$step")"
    index+=1
  done

  if [[ -s "$PANTHEON_ACTIONS_FILE" ]]; then
    echo ''
    pantheon_log_warn '⚠  ACTIONS REQUIRED TO FINISH SETUP:'
    while IFS= read -r line; do
      echo -e "   \033[1;33m•\033[0m $line"
    done <"$PANTHEON_ACTIONS_FILE"
  fi

  echo ''
  pantheon_log_info "Reconnection: ssh -p ${PANTHEON_SSH_PORT} ${PANTHEON_ALLOWED_USER}@<server-ip>"
}

# `update` replaces the installed runtime files (release/package.sh) with another
# version's. Releases ship them as the pantheon.tar.gz asset; a branch has no
# asset, so its source tarball is packaged by the branch's own release/package.sh.
# .manifest lists the shipped files, so files a version drops are deleted and
# anything else in the install directory is never touched.

# Calls the GitHub REST API and stores the response body in PANTHEON_UPDATE_API_BODY.
# Returns 1 on 404, so a caller can probe; any other failure is fatal. Runs in the
# current shell, not $(...), so a fatal error exits the command, not a subshell.
pantheon_update_api() {
  local path="$1"
  local body status message

  body="$(mktemp)"
  if ! status="$(curl -sSL -o "$body" -w '%{http_code}' \
    -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/$PANTHEON_GITHUB_REPO/$path")"; then
    rm -f "$body"
    pantheon_log_error "Cannot reach the GitHub API."
  fi

  case "$status" in
  200)
    PANTHEON_UPDATE_API_BODY="$(<"$body")"
    rm -f "$body"
    ;;
  404)
    rm -f "$body"
    return 1
    ;;
  *)
    message="$(jq -r '.message? // empty' "$body" 2>/dev/null || true)"
    rm -f "$body"
    pantheon_log_error "GitHub API /$path returned HTTP $status${message:+: $message}."
    ;;
  esac
}

# Sets PANTHEON_UPDATE_TARGET_{CHANNEL,REF,COMMIT,URL} for a version argument:
# `latest`, a release tag (the `v` is optional), or a branch name.
pantheon_update_resolve() {
  local version="$1"
  local tag

  if [[ "$version" == latest ]]; then
    pantheon_update_api releases/latest || pantheon_log_error "$PANTHEON_GITHUB_REPO has no published release."
    pantheon_update_resolve_release
    return
  fi

  # Characters valid in tags and branch names that need no URL encoding; anything
  # else cannot name a release or branch this command can fetch.
  [[ "$version" =~ ^[A-Za-z0-9._/-]+$ ]] || pantheon_log_error "No release or branch named '$version' in $PANTHEON_GITHUB_REPO."

  tag="$version"
  [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]] && tag="v$tag"
  if pantheon_update_api "releases/tags/$tag"; then
    pantheon_update_resolve_release
    return
  fi

  if pantheon_update_api "branches/$version"; then
    PANTHEON_UPDATE_TARGET_CHANNEL=branch
    PANTHEON_UPDATE_TARGET_REF="$(jq -r '.name' <<<"$PANTHEON_UPDATE_API_BODY")"
    PANTHEON_UPDATE_TARGET_COMMIT="$(jq -r '.commit.sha' <<<"$PANTHEON_UPDATE_API_BODY")"
    # Checked before any prompt: such a branch has nothing to package.
    pantheon_update_api "contents/release/package.sh?ref=$PANTHEON_UPDATE_TARGET_COMMIT" ||
      pantheon_log_error "Branch $PANTHEON_UPDATE_TARGET_REF has no release/package.sh: it cannot be installed by update."
    # The resolved commit, not the branch: a push during the update cannot change what is installed.
    PANTHEON_UPDATE_TARGET_URL="https://github.com/$PANTHEON_GITHUB_REPO/archive/$PANTHEON_UPDATE_TARGET_COMMIT.tar.gz"
    return
  fi

  pantheon_log_error "No release or branch named '$version' in $PANTHEON_GITHUB_REPO."
}

pantheon_update_resolve_release() {
  PANTHEON_UPDATE_TARGET_CHANNEL=release
  PANTHEON_UPDATE_TARGET_REF="$(jq -r '.tag_name' <<<"$PANTHEON_UPDATE_API_BODY")"
  PANTHEON_UPDATE_TARGET_COMMIT=''
  PANTHEON_UPDATE_TARGET_URL="$(jq -r --arg name "$PANTHEON_RELEASE_ASSET" \
    '.assets[] | select(.name == $name) | .browser_download_url' <<<"$PANTHEON_UPDATE_API_BODY")"
  [[ -n "$PANTHEON_UPDATE_TARGET_URL" ]] ||
    pantheon_log_error "Release $PANTHEON_UPDATE_TARGET_REF has no $PANTHEON_RELEASE_ASSET: it cannot be installed by update."
}

# Sets PANTHEON_UPDATE_INSTALLED_{CHANNEL,REF,COMMIT} from .release.
pantheon_update_read_installed() {
  local root="$1"

  if [[ -f "$root/.release" ]]; then
    PANTHEON_UPDATE_INSTALLED_CHANNEL="$(sed -n 's/^channel=//p' "$root/.release")"
    PANTHEON_UPDATE_INSTALLED_REF="$(sed -n 's/^ref=//p' "$root/.release")"
    PANTHEON_UPDATE_INSTALLED_COMMIT="$(sed -n 's/^commit=//p' "$root/.release")"
  else
    pantheon_log_error "$root has no .release file: reinstall with $PANTHEON_INSTALL_COMMAND"
  fi
}

# Human-readable version: `v1.2.0`, `feat/x@1a2b3c4`.
pantheon_update_describe() {
  local channel="$1" ref="$2" commit="$3"

  case "$channel" in
  branch) printf 'branch %s@%s\n' "$ref" "${commit:0:7}" ;;
  *) printf '%s\n' "$ref" ;;
  esac
}

# Succeeds when release tag $1 is older than release tag $2, by SemVer 2.0.0
# precedence: `v` prefix optional, build metadata ignored, a pre-release is older
# than its release, and pre-release identifiers compare numerically when both
# are numeric, lexically (ASCII) otherwise, numeric before alphanumeric.
pantheon_update_is_older() {
  local a="${1#v}" b="${2#v}"
  local a_pre='' b_pre='' i x y
  local -a a_ids b_ids

  a="${a%%+*}"
  b="${b%%+*}"
  [[ "$a" != *-* ]] || a_pre="${a#*-}"
  [[ "$b" != *-* ]] || b_pre="${b#*-}"

  IFS=. read -ra a_ids <<<"${a%%-*}"
  IFS=. read -ra b_ids <<<"${b%%-*}"
  for i in 0 1 2; do
    x="${a_ids[i]:-0}"
    y="${b_ids[i]:-0}"
    ((10#$x == 10#$y)) || return "$((10#$x < 10#$y ? 0 : 1))"
  done

  [[ -n "$a_pre" ]] || return 1
  [[ -n "$b_pre" ]] || return 0
  IFS=. read -ra a_ids <<<"$a_pre"
  IFS=. read -ra b_ids <<<"$b_pre"
  for ((i = 0; i < ${#a_ids[@]} && i < ${#b_ids[@]}; i++)); do
    x="${a_ids[i]}"
    y="${b_ids[i]}"
    [[ "$x" != "$y" ]] || continue
    if [[ "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]]; then
      return "$((10#$x < 10#$y ? 0 : 1))"
    fi
    [[ ! "$x" =~ ^[0-9]+$ ]] || return 0
    [[ ! "$y" =~ ^[0-9]+$ ]] || return 1
    [[ "$(printf '%s\n%s\n' "$x" "$y" | LC_ALL=C sort | sed -n 1p)" == "$x" ]]
    return
  done
  ((${#a_ids[@]} < ${#b_ids[@]}))
}

# Downloads the target into <stage> as a runtime tree with .manifest and .release.
pantheon_update_fetch() {
  local stage="$1" work="$2"
  local src="$work/source"

  if [[ "$PANTHEON_UPDATE_TARGET_CHANNEL" == release ]]; then
    curl -fsSL "$PANTHEON_UPDATE_TARGET_URL" | tar -xzf - -C "$stage" --strip-components=1 ||
      pantheon_log_error "Cannot download $PANTHEON_UPDATE_TARGET_URL."
  else
    mkdir -p "$src"
    curl -fsSL "$PANTHEON_UPDATE_TARGET_URL" | tar -xzf - -C "$src" --strip-components=1 ||
      pantheon_log_error "Cannot download $PANTHEON_UPDATE_TARGET_URL."
    bash "$src/release/package.sh" "$src" "$stage" branch "$PANTHEON_UPDATE_TARGET_REF" "$PANTHEON_UPDATE_TARGET_COMMIT" ||
      pantheon_log_error "Packaging branch $PANTHEON_UPDATE_TARGET_REF failed."
  fi

  [[ -f "$stage/.manifest" && -f "$stage/.release" && -f "$stage/bin/pantheon" ]] ||
    pantheon_log_error "$PANTHEON_UPDATE_TARGET_URL is not a Pantheon runtime archive."
}

# Moves the staged files into <root> and deletes the files the installed version
# shipped and the new one does not. Every file is renamed into place, never
# rewritten: the running bin/pantheon keeps reading its old inode. .release
# goes last: until it names the new version, a re-run takes the install for the
# old one and redoes the whole update rather than reporting it already installed.
pantheon_update_apply() {
  local root="$1" stage="$2" old_manifest="$3"
  local file dir

  while IFS= read -r file; do
    mkdir -p "$root/$(dirname "$file")"
    mv -f "$stage/$file" "$root/$file"
  done <"$stage/.manifest"

  while IFS= read -r file; do
    rm -f "$root/$file"
    dir="$(dirname "$file")"
    [[ "$dir" == . ]] || (cd "$root" && rmdir -p --ignore-fail-on-non-empty "$dir" 2>/dev/null) || true
  done < <(LC_ALL=C comm -23 <(LC_ALL=C sort -u "$old_manifest") <(LC_ALL=C sort -u "$stage/.manifest"))

  mv -f "$stage/.manifest" "$root/.manifest"
  mv -f "$stage/.release" "$root/.release"
}

validate_not_empty() {
  if [[ -z "$1" ]]; then
    echo "must not be empty"
  fi
}

validate_port() {
  if [[ ! "$1" =~ ^[0-9]+$ ]]; then
    echo 'must be an integer'
    return
  fi

  if (($1 < 1 || $1 > 65535)); then
    echo 'must be between 1 and 65535'
  fi
}

pantheon_setup_all_command() {

  #!/usr/bin/env bash

  # Core steps in dependency order: init prepares the disk and clock, packages
  # installs the tooling (augeas for ssh, jq for update), then docker, tailscale,
  # ssh, ufw and fail2ban bring the platform up and lock it down. The extras are
  # conveniences for the operator, not part of a minimal server.
  declare -ga PANTHEON_CORE_STEPS=(init packages docker tailscale ssh ufw fail2ban)
  declare -ga PANTHEON_EXTRA_STEPS=(brew shell)

  # These are the same functions './bin/pantheon setup <step>' dispatches to, so
  # each step has one implementation.
  pantheon_setup_all() {
    local step
    local -a steps=("${PANTHEON_CORE_STEPS[@]}")

    [[ "$PANTHEON_EXTRAS" != 1 ]] || steps+=("${PANTHEON_EXTRA_STEPS[@]}")

    # A fresh list per run: the file lives in /tmp across runs, and the summary
    # must not repeat what an earlier run asked for.
    : >"$PANTHEON_ACTIONS_FILE"

    for step in "${steps[@]}"; do
      "pantheon_setup_${step}_command"
    done

    # As the user, after the steps above, so its login-shell checks see the shell
    # they will get. A failed check is a follow-up, not a reason to abort.
    pantheon_log_info "Putting pantheon on ${PANTHEON_ALLOWED_USER}'s PATH..."
    if ! sudo -u "$PANTHEON_ALLOWED_USER" -H "$PANTHEON_CLI_BIN" install; then
      pantheon_register_action "Fix what 'pantheon install' reported above, then re-run ./bin/pantheon install as ${PANTHEON_ALLOWED_USER}."
    fi

    # Prints the ACTIONS REQUIRED list the steps registered along the way (SSH
    # port confirmation, Tailscale authentication, docker group re-login). Nothing
    # else calls it, so without this a full run ends without ever showing them.
    pantheon_print_setup_summary "${steps[@]}"
  }

  pantheon_prompt_value() {
    local label="$1" current="$2" reply
    read -r -p "Enter ${label} (default: ${current}): " reply
    printf '%s\n' "${reply:-$current}"
  }

  # Interactive setup that prompts for every value, pre-filled from flags, env
  # vars and defaults.
  pantheon_interactive_setup() {
    pantheon_require_root
    pantheon_resolve_setup_context

    # PANTHEON_EXTRAS arrives as the 'pantheon_extras' env var and is normalized
    # to 0 or 1 here.
    declare -g PANTHEON_EXTRAS
    if [[ -n "${args['--extras']:-}" || "${PANTHEON_EXTRAS:-}" == 1 ]]; then
      PANTHEON_EXTRAS=1
    else
      PANTHEON_EXTRAS=0
    fi

    echo ''
    echo '🏛️  Pantheon Setup - Interactive Mode'
    echo '====================================='

    PANTHEON_SERVER_NAME="$(pantheon_prompt_value 'server name' "$PANTHEON_SERVER_NAME")"
    PANTHEON_ALLOWED_USER="$(pantheon_prompt_value 'allowed user' "$PANTHEON_ALLOWED_USER")"
    PANTHEON_SSH_PORT="$(pantheon_prompt_value 'SSH port' "$PANTHEON_SSH_PORT")"
    PANTHEON_TIMEZONE="$(pantheon_prompt_value 'timezone' "$PANTHEON_TIMEZONE")"
    PANTHEON_LVM_DEVICE="$(pantheon_prompt_value 'LVM device' "$PANTHEON_LVM_DEVICE")"

    if [[ "$PANTHEON_EXTRAS" != 1 ]]; then
      local reply
      read -r -p "Install the extras (Homebrew with bottom, Starship, Ghostty terminfo)? (y/N): " reply
      [[ ! "$reply" =~ ^[Yy]$ ]] || PANTHEON_EXTRAS=1
    fi

    # Every step resolves its settings again, and a flag wins over a global there,
    # so the answers go into the flags: otherwise a value typed over a pre-filled
    # flag would be silently replaced by the flag. Resolving once more also runs
    # the user guards on the answer and renames the actions file.
    args['--server-name']="$PANTHEON_SERVER_NAME"
    args['--allowed-user']="$PANTHEON_ALLOWED_USER"
    args['--ssh-port']="$PANTHEON_SSH_PORT"
    args['--timezone']="$PANTHEON_TIMEZONE"
    args['--lvm-device']="$PANTHEON_LVM_DEVICE"
    pantheon_resolve_setup_context
    [[ "$(validate_port "$PANTHEON_SSH_PORT")" == '' ]] || pantheon_log_error "SSH port '$PANTHEON_SSH_PORT' $(validate_port "$PANTHEON_SSH_PORT")."

    echo ''
    echo '📋 Setup Summary:'
    echo "   Server Name: $PANTHEON_SERVER_NAME"
    echo "   Allowed User: $PANTHEON_ALLOWED_USER"
    echo "   SSH Port: $PANTHEON_SSH_PORT"
    echo "   Timezone: ${PANTHEON_TIMEZONE:-unchanged}"
    echo "   LVM Device: $PANTHEON_LVM_DEVICE"
    echo "   Extras: $([[ "$PANTHEON_EXTRAS" == 1 ]] && echo yes || echo no)"
    echo ''

    local confirm
    read -r -p 'Proceed with setup? (y/N): ' confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo 'Setup cancelled.'
      exit 0
    fi

    pantheon_ensure_actions_file
    PANTHEON_CONFIRMED=1 pantheon_setup_all
  }

  pantheon_interactive_setup

}

pantheon_setup_init_command() {

  pantheon_setup_init() {
    pantheon_prepare_setup_step 'Extend the LVM root volume to the full disk (when there is one) and set the timezone.'

    # The Ubuntu Server installer's LVM layout leaves the rest of the disk
    # unallocated, so this claims it. A host installed without LVM has no such
    # volume: 'lvs' fails on it, and under 'set -euo pipefail' that failure used to
    # abort the whole run at its first step, so the volume is checked up front.
    # 'lvextend' exits non-zero when there is nothing left to claim, so the free
    # extents are checked too. 'resize2fs' needs no such guard: it exits 0 when the
    # filesystem already spans the volume.
    local volume_group free_extents
    if lvs "$PANTHEON_LVM_DEVICE" >/dev/null 2>&1; then
      volume_group="$(lvs --noheadings -o vg_name "$PANTHEON_LVM_DEVICE" | tr -d '[:space:]')"
      free_extents="$(vgs --noheadings -o vg_free_count "$volume_group" | tr -d '[:space:]')"

      if [[ "$free_extents" =~ ^[0-9]+$ ]] && ((free_extents > 0)); then
        pantheon_log_info 'Extending LVM logical volume to full disk capacity...'
        lvextend -An -l +100%FREE "$PANTHEON_LVM_DEVICE"
      else
        pantheon_log_info "No unallocated extents left in ${volume_group}."
      fi

      resize2fs "$PANTHEON_LVM_DEVICE"
      pantheon_log_success 'Disk fully allocated.'
    else
      pantheon_log_info "No logical volume at ${PANTHEON_LVM_DEVICE}: skipping the storage step (pass --lvm-device for another volume)."
    fi

    if [[ -z "$PANTHEON_TIMEZONE" ]]; then
      pantheon_log_warn 'Could not read the current timezone: pass --timezone to set one.'
    elif [[ "$PANTHEON_TIMEZONE" == "$(pantheon_current_timezone)" ]]; then
      pantheon_log_success "Timezone already ${PANTHEON_TIMEZONE}."
    else
      pantheon_log_info "Setting the server timezone to ${PANTHEON_TIMEZONE}..."
      timedatectl set-timezone "$PANTHEON_TIMEZONE"
      pantheon_log_success "Timezone set to ${PANTHEON_TIMEZONE}."
    fi
  }

  pantheon_setup_init

}

pantheon_setup_packages_command() {

  pantheon_setup_packages() {
    pantheon_prepare_setup_step 'Install essential packages.'

    pantheon_log_info 'Updating system and installing essential packages...'
    apt-get update
    # '--with-new-pkgs' is what makes this equivalent to 'apt upgrade': plain
    # 'apt-get upgrade' holds back any upgrade that needs a new package, which is
    # exactly what a kernel ABI bump is (linux-generic pulling a new linux-image).
    apt-get upgrade -y --with-new-pkgs
    apt-get install -y \
      augeas-lenses \
      augeas-tools \
      bind9-dnsutils \
      build-essential \
      fio \
      htop \
      jq \
      lm-sensors \
      nvme-cli \
      python3 \
      python3-pip \
      python3-venv \
      s-tui \
      tree \
      unattended-upgrades \
      unzip

    pantheon_log_success 'Essential packages installed.'
  }

  pantheon_setup_packages

}

pantheon_setup_docker_command() {

  pantheon_setup_docker() {
    pantheon_prepare_setup_step 'Install Docker and Docker Compose.'

    pantheon_log_info 'Installing Docker and Docker Compose...'
    apt-get update
    apt-get install -y ca-certificates curl
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc

    # shellcheck source=/dev/null # the host's file, read at runtime
    tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
EOF
    apt-get update

    apt-get install -y \
      docker-ce \
      docker-ce-cli \
      containerd.io \
      docker-buildx-plugin \
      docker-compose-plugin

    if docker --version && docker compose version; then
      pantheon_log_success 'Docker installed.'
    else
      pantheon_log_error 'Docker installation failed.'
    fi

    usermod -aG docker "${PANTHEON_ALLOWED_USER}"
    pantheon_log_success 'User added to docker group.'
    pantheon_register_action "Log out and back in as ${PANTHEON_ALLOWED_USER} so the docker group applies to your session."
  }

  pantheon_setup_docker

}

pantheon_setup_tailscale_command() {

  pantheon_setup_tailscale() {
    pantheon_prepare_setup_step 'Install Tailscale.'

    # Resolved like the Docker source: UBUNTU_CODENAME still names the Ubuntu base
    # on derivatives, where VERSION_CODENAME names the derivative instead.
    local codename keyring staged
    # shellcheck source=/dev/null # the host's file, read at runtime
    codename="$(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")"

    # Upstream's own path, and the one the 'tailscale-archive-keyring' package
    # (a dependency of 'tailscale') owns after the first install, so signing-key
    # rotations arrive through apt instead of silently breaking the repository.
    keyring='/usr/share/keyrings/tailscale-archive-keyring.gpg'

    pantheon_log_info "Installing Tailscale for ${codename}..."

    apt-get update
    apt-get install -y ca-certificates curl

    # Staged through a temp file rather than 'curl | tee $keyring'. A pipeline
    # reports tee's status, not curl's, so an unpublished codename used to leave a
    # truncated keyring and an empty source behind and only surfaced later as
    # 'Unable to locate package tailscale'. Tailscale signs every suite with the
    # same key, so a 404 here means the release itself is not published yet.
    staged="$(mktemp)"
    if ! curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/${codename}.noarmor.gpg" -o "$staged"; then
      rm -f "$staged"
      pantheon_log_error "Tailscale publishes no repository for Ubuntu '${codename}' yet."
    fi

    install -m 0644 "$staged" "$keyring"
    rm -f "$staged"

    # Clean cutover from the one-line source this step used to fetch. Leaving it
    # next to the deb822 file would configure the same suite twice.
    rm -f /etc/apt/sources.list.d/tailscale.list

    # Written locally in deb822, matching docker.sources, instead of fetching
    # upstream's .tailscale-keyring.list: that is legacy one-line format and one
    # more per-codename artifact that can 404 on a freshly released Ubuntu.
    tee /etc/apt/sources.list.d/tailscale.sources <<EOF
Types: deb
URIs: https://pkgs.tailscale.com/stable/ubuntu
Suites: ${codename}
Components: main
Signed-By: ${keyring}
EOF

    apt-get update
    apt-get install -y tailscale

    if command -v tailscale >/dev/null 2>&1; then
      pantheon_log_success 'Tailscale installed.'
      pantheon_register_action "Authenticate Tailscale: run 'sudo tailscale up' from your workstation via SSH (GUI with browser needed)."
    else
      pantheon_log_error 'Tailscale installation failed.'
    fi
  }

  pantheon_setup_tailscale

}

pantheon_setup_ssh_command() {

  # Puts back everything the hardening step moved or overwrote: the drop-ins it
  # emptied out of PANTHEON_SSHD_CONFIG_DIR, then the pre-change sshd_config if a
  # candidate had already been committed. 'previous' only exists after the commit,
  # so an early failure restores drop-ins alone.
  pantheon_ssh_restore() {
    local stage="$1"

    local saved=()
    shopt -s nullglob
    saved=("${stage}/dropins/"*.conf)
    shopt -u nullglob

    if ((${#saved[@]} > 0)); then
      mkdir -p "$PANTHEON_SSHD_CONFIG_DIR"
      mv -f "${saved[@]}" "${PANTHEON_SSHD_CONFIG_DIR}/"
    fi

    if [[ -f "${stage}/previous" ]]; then
      cat "${stage}/previous" >"$PANTHEON_SSHD_CONFIG"
    fi
  }

  # Abort before anything under /etc/ssh was committed: restore and exit. The
  # running daemon still serves the configuration it started with, so there is
  # nothing to restart.
  # Keeps the drop-ins a successful run moved out of PANTHEON_SSHD_CONFIG_DIR: they
  # must stay out of sshd's way, but they may hold settings the operator wants
  # back. Kept next to the directory, under a name sshd never reads.
  pantheon_ssh_keep_dropins() {
    local stage="$1"
    local backup
    local saved=()
    shopt -s nullglob
    saved=("${stage}/dropins/"*.conf)
    shopt -u nullglob

    ((${#saved[@]} > 0)) || return 0
    backup="${PANTHEON_SSHD_CONFIG_DIR}.pantheon-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup"
    mv -f "${saved[@]}" "${backup}/"
    pantheon_log_info "Moved ${#saved[@]} drop-in(s) that would override the hardening to ${backup}."
  }

  pantheon_ssh_abort() {
    local stage="$1"
    shift

    pantheon_ssh_restore "$stage"
    rm -rf "$stage"
    pantheon_log_error "$*"
  }

  # Abort after the candidate was committed and the daemon restarted: the previous
  # configuration has to be put back *and* served again, otherwise the step exits
  # leaving sshd on the configuration that just failed to come up.
  pantheon_ssh_abort_running() {
    local stage="$1"
    local unit="$2"
    shift 2

    pantheon_ssh_restore "$stage"
    systemctl daemon-reload
    systemctl restart "$unit" || pantheon_log_warn "Could not restart ${unit} after rollback -- run 'systemctl restart ${unit}' from the console."
    rm -rf "$stage"
    pantheon_log_error "$*"
  }

  pantheon_setup_ssh() {
    # Resolved up front because bash expands ${PANTHEON_SSH_PORT} at the call site
    # below - before pantheon_prepare_setup_step could resolve it - so a standalone
    # 'setup ssh' on a fresh host died on 'unbound variable'. Resolution is
    # idempotent, so prepare doing it again is free.
    pantheon_resolve_setup_context
    pantheon_prepare_setup_step "Harden SSH configuration (port ${PANTHEON_SSH_PORT}, key-only auth)."

    # UsePAM no (below) makes sshd check the account itself, and it refuses every
    # login to a locked account, keys included: a password field starting with '!'.
    # Installers that create a key-only user (cloud images, autoinstall) leave it
    # exactly like that, so hardening would lock the operator out on the next
    # login. '*' is not locked for sshd, so it unlocks the account for keys alone.
    local password_field
    password_field="$(getent shadow "$PANTHEON_ALLOWED_USER" | cut -d: -f2)"
    if [[ "$password_field" == '!'* ]]; then
      pantheon_log_error "The account '${PANTHEON_ALLOWED_USER}' is locked (no usable password). With the hardened config sshd refuses every login to a locked account, keys included, and you would be locked out. Set a password (sudo passwd ${PANTHEON_ALLOWED_USER}) or allow key logins only (sudo usermod -p '*' ${PANTHEON_ALLOWED_USER}), then re-run."
    fi

    pantheon_log_info "Configuring SSH (${PANTHEON_SSHD_CONFIG})..."

    if [[ ! -f "${PANTHEON_SSHD_CONFIG}.orig" ]]; then
      cp "$PANTHEON_SSHD_CONFIG" "${PANTHEON_SSHD_CONFIG}.orig"
      pantheon_log_info "Original sshd_config backed up to ${PANTHEON_SSHD_CONFIG}.orig"
    fi

    # Nothing under /etc/ssh is committed until a complete candidate has passed
    # 'sshd -t'. The earlier version edited the live file and validated afterwards,
    # so a keyword sshd rejected stayed on disk: the daemon then failed to start on
    # the next boot and the host answered on no port at all - recoverable only with
    # physical access. Augeas edits the staged copy instead, because 'augtool -r'
    # resolves the lens path /files/etc/ssh/sshd_config inside the staging root.
    local stage candidate
    stage="$(mktemp -d)"
    candidate="${stage}/etc/ssh/sshd_config"
    mkdir -p "${stage}/dropins"
    install -D -m 0600 "$PANTHEON_SSHD_CONFIG" "$candidate"

    # The Include line in sshd_config points at an absolute path, so a staged
    # candidate is still validated against the live drop-in directory - and on
    # Ubuntu those drop-ins win, since sshd takes the first value it sees and the
    # Include sits at the top of the file. Empty the directory first so 'sshd -t'
    # sees exactly what the daemon will see. Moved rather than deleted, so a failed
    # validation puts them back.
    local dropins=()
    shopt -s nullglob
    dropins=("${PANTHEON_SSHD_CONFIG_DIR}"/*.conf)
    shopt -u nullglob

    if ((${#dropins[@]} > 0)); then
      pantheon_log_info "Moving ${#dropins[@]} sshd_config.d drop-in(s) aside (backed up on success, restored on failure)..."
      mv -f "${dropins[@]}" "${stage}/dropins/"
    fi

    # ChallengeResponseAuthentication is deliberately absent: OpenSSH 8.7 made it a
    # deprecated alias of KbdInteractiveAuthentication (servconf.h SSHCONF_ALIAS),
    # which is set two lines down, so writing both only duplicated one setting.
    #
    # augtool's exit status is checked because '-s' reports a failed set or save
    # through it, and the sshd lens refuses to save new global keys into a file that
    # already has a Match block. Unchecked, that silently produced a config missing
    # every hardening directive.
    pantheon_log_info 'Applying SSH hardening to a staged copy via Augeas...'
    augtool -s -r "$stage" <<AUGEOF || pantheon_ssh_abort "$stage" 'augtool could not write the staged sshd_config -- /etc/ssh left untouched.'
set /files/etc/ssh/sshd_config/Port "$PANTHEON_SSH_PORT"
set /files/etc/ssh/sshd_config/PasswordAuthentication no
set /files/etc/ssh/sshd_config/KbdInteractiveAuthentication no
set /files/etc/ssh/sshd_config/PubkeyAuthentication yes
set /files/etc/ssh/sshd_config/AuthenticationMethods publickey
set /files/etc/ssh/sshd_config/UsePAM no
set /files/etc/ssh/sshd_config/PermitRootLogin no
set /files/etc/ssh/sshd_config/MaxAuthTries 3
set /files/etc/ssh/sshd_config/LoginGraceTime 30
set /files/etc/ssh/sshd_config/X11Forwarding no
set /files/etc/ssh/sshd_config/AllowTcpForwarding no
set /files/etc/ssh/sshd_config/AllowUsers/1 "$PANTHEON_ALLOWED_USER"
AUGEOF

    pantheon_log_info 'Validating the staged configuration...'
    sshd -t -f "$candidate" || pantheon_ssh_abort "$stage" 'Staged sshd configuration is invalid -- /etc/ssh left untouched and SSH keeps serving the current config.'

    # Only now does the live file change. Content is copied into the existing inode
    # rather than moved over it, which keeps the file's mode and owner.
    cp "$PANTHEON_SSHD_CONFIG" "${stage}/previous"
    cat "$candidate" >"$PANTHEON_SSHD_CONFIG"

    # Ubuntu ships socket-activated SSH: 'ssh.socket' owns the listening port and
    # its shipped unit hardcodes 22, while 'ssh.service' is RequiredBy that socket
    # and inherits the socket's file descriptor. Restarting the service alone
    # therefore keeps serving port 22 whatever sshd_config says. Ubuntu's
    # 'sshd-socket-generator' turns the sshd_config Port into an ssh.socket
    # drop-in, but generators only re-run on a daemon-reload.
    pantheon_log_info 'Reloading systemd units so the SSH socket adopts the new port...'
    systemctl daemon-reload

    local unit='ssh'
    if systemctl is-enabled --quiet ssh.socket 2>/dev/null; then
      unit='ssh.socket'
    fi

    pantheon_log_info "Restarting ${unit}..."
    systemctl restart "$unit" || pantheon_ssh_abort_running "$stage" "$unit" "Restarting ${unit} failed -- rolled back to the previous SSH configuration."

    # The listening socket is observed directly instead of parsing sshd -T or unit
    # properties: whether the next login connects is decided here and nowhere else.
    # UFW runs after this step and opens only PANTHEON_SSH_PORT, so a daemon left on
    # 22 is unreachable. The retries cover ssh.service, which binds shortly after
    # systemctl returns; ssh.socket is already listening once restart completes.
    for _ in 1 2 3 4 5; do
      if ss -Htln "sport = :${PANTHEON_SSH_PORT}" 2>/dev/null | grep -q .; then
        pantheon_ssh_keep_dropins "$stage"
        rm -rf "$stage"
        pantheon_log_success "SSH hardened on port ${PANTHEON_SSH_PORT}. AllowUsers: ${PANTHEON_ALLOWED_USER}"
        pantheon_register_action "Open a second session on port ${PANTHEON_SSH_PORT} before closing this one."
        return 0
      fi
      sleep 1
    done

    pantheon_ssh_abort_running "$stage" "$unit" "Nothing is listening on port ${PANTHEON_SSH_PORT} after restarting ${unit} -- rolled back to the previous SSH configuration."
  }

  pantheon_setup_ssh

}

pantheon_setup_ufw_command() {

  pantheon_setup_ufw() {
    local reset="${args['--reset']:-}"

    if [[ -n "$reset" ]]; then
      pantheon_prepare_setup_step 'Configure the UFW firewall: RESET first, deleting every existing rule, then deny incoming and allow SSH.'
    else
      pantheon_prepare_setup_step 'Configure the UFW firewall: deny incoming, allow SSH; existing rules are kept.'
    fi

    # Preinstalled on Ubuntu Server, but not on minimal or cloud images.
    apt-get install -y ufw

    pantheon_log_info 'Configuring UFW...'
    # Additive by default: a server runs more than this baseline, and other
    # services add rules of their own that a reset would silently delete.
    if [[ -n "$reset" ]]; then
      ufw --force reset
    fi
    ufw default deny incoming
    ufw default allow outgoing

    # 'ufw allow' skips a rule that already exists, so a re-run adds nothing.
    ufw allow "${PANTHEON_SSH_PORT}/tcp" comment 'SSH'

    ufw --force enable

    if [[ -n "$reset" ]]; then
      pantheon_log_success "UFW reset and enabled: incoming traffic denied except SSH (${PANTHEON_SSH_PORT})."
    else
      pantheon_log_success "UFW enabled: incoming traffic denied except SSH (${PANTHEON_SSH_PORT}) and the rules that were already there."
    fi
    # A rule for an earlier SSH port is not removed: only the operator knows
    # whether something else still listens there.
    pantheon_log_info "Review the rules with 'sudo ufw status numbered'; remove a stale one with 'sudo ufw delete <number>'."
  }

  pantheon_setup_ufw

}

pantheon_setup_fail2ban_command() {

  pantheon_setup_fail2ban() {
    pantheon_prepare_setup_step 'Install and configure fail2ban.'

    pantheon_log_info 'Installing fail2ban...'
    apt-get install -y fail2ban

    pantheon_log_info "Writing ${PANTHEON_FAIL2BAN_JAIL}..."
    # Ubuntu Server has no rsyslog, so /var/log/auth.log never exists and the
    # journal is the only source of sshd auth failures. 'backend = systemd' is set
    # explicitly rather than inherited from Ubuntu's jail.d/defaults-debian.conf,
    # so the jail stays valid if that distro file ever changes.
    #
    # 'ignoreip' covers the Tailscale CGNAT v4 pool and the tailnet ULA v6 prefix,
    # because every administrative login reaches this host over tailscale0. Without
    # it fail2ban's default (loopback only) treats the admin path as hostile: sshd
    # sets MaxAuthTries 3, so a client whose agent offers three keys exhausts
    # maxretry on its first connection, and any reconnect loop re-arms the ban past
    # bantime. Rate-limiting buys nothing against 'AuthenticationMethods publickey'
    # anyway; the jail still guards the port UFW exposes publicly.
    cat >"$PANTHEON_FAIL2BAN_JAIL" <<EOF
[sshd]
enabled  = true
port     = ${PANTHEON_SSH_PORT}
filter   = sshd
backend  = systemd
ignoreip = 127.0.0.1/8 ::1 100.64.0.0/10 fd7a:115c:a1e0::/48
maxretry = 3
bantime  = 1h
findtime = 10m
EOF

    pantheon_log_info 'Restarting fail2ban...'
    systemctl enable --now fail2ban
    systemctl restart fail2ban
    pantheon_log_success 'fail2ban configured and running.'
  }

  pantheon_setup_fail2ban

}

pantheon_setup_brew_command() {

  pantheon_setup_brew() {
    pantheon_prepare_setup_step 'Install Homebrew and bottom.'

    pantheon_log_info "Installing Homebrew (as ${PANTHEON_ALLOWED_USER})..."
    mkdir -p /home/linuxbrew/.linuxbrew
    chown -R "${PANTHEON_ALLOWED_USER}:${PANTHEON_ALLOWED_USER}" /home/linuxbrew

    sudo -u "${PANTHEON_ALLOWED_USER}" bash -c 'NONINTERACTIVE=1 bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'

    local brew_prefix
    brew_prefix=$(sudo -u "${PANTHEON_ALLOWED_USER}" bash -c '
  		if [ -d ~/.linuxbrew ]; then
  			echo "$HOME/.linuxbrew"
  		elif [ -d /home/linuxbrew/.linuxbrew ]; then
  			echo "/home/linuxbrew/.linuxbrew"
  		fi
  	')

    if [[ -n "$brew_prefix" ]]; then
      pantheon_register_bashrc_entry 'Homebrew' "eval \"\$(${brew_prefix}/bin/brew shellenv)\""
      pantheon_log_success "Homebrew installed and configured for ${PANTHEON_ALLOWED_USER}."

      # No 'eval "$(brew shellenv)"' here: brew derives HOMEBREW_PREFIX from its
      # own path, every call below is absolute and runs through 'sudo -u', and
      # exported vars would die with this process anyway. The .bashrc entry above
      # is what puts brew on the user's PATH.
      # '--no-ask' because upstream made ask-mode the default for 'brew install':
      # it prompts for confirmation before downloading, and only skips the prompt
      # when there is no TTY. Setup runs on a console, so without this every
      # formula below stops and waits for a keypress.
      pantheon_log_info "Installing bottom via Homebrew..."
      sudo -u "${PANTHEON_ALLOWED_USER}" bash -c "${brew_prefix}/bin/brew install --no-ask bottom"
      pantheon_log_success "bottom installed via Homebrew for user ${PANTHEON_ALLOWED_USER}."
    else
      pantheon_log_error 'Homebrew installation failed.'
    fi
  }

  pantheon_setup_brew

}

pantheon_setup_shell_command() {

  pantheon_setup_shell() {
    # Resolved before the message below expands it: see setup/ssh.sh.
    pantheon_resolve_setup_context
    pantheon_prepare_setup_step "Set up the shell for ${PANTHEON_ALLOWED_USER}: Starship prompt, Ghostty terminfo, linger."

    pantheon_log_info "Setting up shell with Starship prompt for ${PANTHEON_ALLOWED_USER}..."
    apt-get install -y starship

    # Lets the user's systemd services run without an open session, and keeps
    # them running after logout.
    pantheon_log_info "Enabling linger for ${PANTHEON_ALLOWED_USER}..."
    loginctl enable-linger "$PANTHEON_ALLOWED_USER"

    # shellcheck disable=SC2016 # We want to register the literal command, not its output
    pantheon_register_bashrc_entry 'Starship' 'eval "$(starship init bash)"'

    # Ghostty's ssh-terminfo installs xterm-ghostty into ~/.terminfo, which ncurses
    # ignores for root and for setcap binaries (such as nvtop with cap_perfmon).
    pantheon_log_info "Installing xterm-ghostty terminfo into /etc/terminfo..."
    tic -x -o /etc/terminfo "$PANTHEON_REPO_ROOT/terminfo/xterm-ghostty.terminfo"
    pantheon_log_success "Shell set up for ${PANTHEON_ALLOWED_USER}."
  }

  pantheon_setup_shell

}

pantheon_update_command() {

  pantheon_update() {
    local root="$PANTHEON_REPO_ROOT"
    local installed target work stage old_manifest lock_fd

    # The install lives in the operator's home; root would leave root-owned files behind.
    [[ $EUID -ne 0 ]] || pantheon_log_error "Run update as the user who owns $root, not with sudo."
    # jq reads the GitHub API answers; 'setup packages' installs it, but update may run before setup did.
    command -v jq >/dev/null || pantheon_log_error "update needs jq: sudo apt-get install -y jq (or sudo $PANTHEON_CLI_BIN setup packages)."

    # One update per install, held until exit: two runs would interleave their renames
    # into a mix of versions. Failing fast, not waiting, means no run acts on state
    # read before another one changed it.
    exec {lock_fd}<"$root"
    flock -n "$lock_fd" || pantheon_log_error "Another update is already running in $root."

    pantheon_update_read_installed "$root"
    pantheon_log_info "Resolving '${args[version]}' on GitHub..."
    pantheon_update_resolve "${args[version]}"

    installed="$(pantheon_update_describe "$PANTHEON_UPDATE_INSTALLED_CHANNEL" "$PANTHEON_UPDATE_INSTALLED_REF" "$PANTHEON_UPDATE_INSTALLED_COMMIT")"
    target="$(pantheon_update_describe "$PANTHEON_UPDATE_TARGET_CHANNEL" "$PANTHEON_UPDATE_TARGET_REF" "$PANTHEON_UPDATE_TARGET_COMMIT")"

    # A release tag names one build; a branch moves, so only its commit identifies it.
    if [[ "$PANTHEON_UPDATE_INSTALLED_CHANNEL" == "$PANTHEON_UPDATE_TARGET_CHANNEL" &&
      "$PANTHEON_UPDATE_INSTALLED_REF" == "$PANTHEON_UPDATE_TARGET_REF" &&
      ("$PANTHEON_UPDATE_TARGET_CHANNEL" == release || "$PANTHEON_UPDATE_INSTALLED_COMMIT" == "$PANTHEON_UPDATE_TARGET_COMMIT") ]]; then
      pantheon_log_success "Pantheon $installed is already installed."
      return 0
    fi

    pantheon_confirm "Update Pantheon in $root from $installed to $target?"

    if [[ "$PANTHEON_UPDATE_TARGET_CHANNEL" == branch ]]; then
      pantheon_log_warn "$target is not a release: it is unstable, may be broken, and may change the host incompatibly."
      pantheon_confirm "Install the unstable $target anyway?"
    elif [[ "$PANTHEON_UPDATE_INSTALLED_REF" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ && "$PANTHEON_UPDATE_INSTALLED_CHANNEL" != branch ]] &&
      pantheon_update_is_older "$PANTHEON_UPDATE_TARGET_REF" "$PANTHEON_UPDATE_INSTALLED_REF"; then
      pantheon_log_warn "$target is older than the installed $installed: its setup steps may not expect what a newer version configured."
      pantheon_confirm "Downgrade to $target anyway?"
    fi

    work="$(mktemp -d)"
    # Staged inside the install, on its filesystem, so files move into place by rename.
    stage="$(mktemp -d "$root/.update.XXXXXX")"
    # shellcheck disable=SC2064 # expand now: the locals are gone when the trap fires
    trap "rm -rf '$work' '$stage'" EXIT

    pantheon_log_info "Downloading $target..."
    pantheon_update_fetch "$stage" "$work"

    old_manifest="$work/installed.manifest"
    cp "$root/.manifest" "$old_manifest"

    pantheon_update_apply "$root" "$stage" "$old_manifest"
    pantheon_log_success "Pantheon $target installed in $root."
    pantheon_log_info "Nothing on the host changed: re-run a setup step to apply what $target does differently (sudo $root/bin/pantheon setup <step>)."
  }

  pantheon_update

}

pantheon_install_command() {

  pantheon_install() {
    # Everything lands in the caller's home, so root would install it for root.
    [[ $EUID -ne 0 ]] || pantheon_log_error "Run install as the user who uses the CLI, not with sudo: it installs into your home directory. 'setup all' runs it for the allowed user."

    local link file
    link="$(pantheon_install_link)"
    file="$(pantheon_install_completion_file)"

    # Only ever replaces a symlink: a real file there is someone else's command.
    if [[ -e "$link" && ! -L "$link" ]]; then
      pantheon_log_error "$link exists and is not a symlink - move it aside, then re-run."
    fi
    if [[ "$(readlink "$link" 2>/dev/null || true)" != "$PANTHEON_CLI_BIN" ]]; then
      mkdir -p "${link%/*}"
      ln -sfn "$PANTHEON_CLI_BIN" "$link"
      pantheon_log_info "Linked $link -> $PANTHEON_CLI_BIN."
    fi

    if [[ ! -f "$file" ]] || ! cmp -s "$file" <(pantheon_install_completion_script); then
      mkdir -p "${file%/*}"
      pantheon_install_completion_script >"$file.$$"
      mv "$file.$$" "$file"
      pantheon_log_info "Wrote $file."
    fi

    pantheon_install_checks
  }

  pantheon_install

}

pantheon_completions_command() {

  send_completions "${args[shell]}"

}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        pantheon_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    setup)
      action="setup"
      shift
      pantheon_setup_parse_requirements "$@"
      shift $#
      ;;

    update)
      action="update"
      shift
      pantheon_update_parse_requirements "$@"
      shift $#
      ;;

    install)
      action="install"
      shift
      pantheon_install_parse_requirements "$@"
      shift $#
      ;;

    completions)
      action="completions"
      shift
      pantheon_completions_parse_requirements "$@"
      shift $#
      ;;

    "")
      pantheon_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

pantheon_setup_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        pantheon_setup_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in

    all)
      action="all"
      shift
      pantheon_setup_all_parse_requirements "$@"
      shift $#
      ;;

    init)
      action="init"
      shift
      pantheon_setup_init_parse_requirements "$@"
      shift $#
      ;;

    packages)
      action="packages"
      shift
      pantheon_setup_packages_parse_requirements "$@"
      shift $#
      ;;

    docker)
      action="docker"
      shift
      pantheon_setup_docker_parse_requirements "$@"
      shift $#
      ;;

    tailscale)
      action="tailscale"
      shift
      pantheon_setup_tailscale_parse_requirements "$@"
      shift $#
      ;;

    ssh)
      action="ssh"
      shift
      pantheon_setup_ssh_parse_requirements "$@"
      shift $#
      ;;

    ufw)
      action="ufw"
      shift
      pantheon_setup_ufw_parse_requirements "$@"
      shift $#
      ;;

    fail2ban)
      action="fail2ban"
      shift
      pantheon_setup_fail2ban_parse_requirements "$@"
      shift $#
      ;;

    brew)
      action="brew"
      shift
      pantheon_setup_brew_parse_requirements "$@"
      shift $#
      ;;

    shell)
      action="shell"
      shift
      pantheon_setup_shell_parse_requirements "$@"
      shift $#
      ;;

    *)
      action="all"
      pantheon_setup_all_parse_requirements "$@"
      shift $#
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

pantheon_setup_all_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        pantheon_setup_all_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  if [[ -v PANTHEON_SSH_PORT ]]; then
    validation_output="$(validate_port "$PANTHEON_SSH_PORT")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in environment variable %s:\n%s\n" "PANTHEON_SSH_PORT" "$validation_output" >&2
      exit 1
    fi
  fi

  action="setup all"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --server-name | -n)

        if [[ -n ${2+x} ]]; then
          args['--server-name']="$2"
          shift
          shift
        else
          printf "%s\n" "--server-name requires an argument: --server-name, -n NAME" >&2
          exit 1
        fi
        ;;

      --allowed-user | -u)

        if [[ -n ${2+x} ]]; then
          args['--allowed-user']="$2"
          shift
          shift
        else
          printf "%s\n" "--allowed-user requires an argument: --allowed-user, -u USER" >&2
          exit 1
        fi
        ;;

      --ssh-port | -p)

        if [[ -n ${2+x} ]]; then
          args['--ssh-port']="$2"
          shift
          shift
        else
          printf "%s\n" "--ssh-port requires an argument: --ssh-port, -p PORT" >&2
          exit 1
        fi
        ;;

      --timezone | -t)

        if [[ -n ${2+x} ]]; then
          args['--timezone']="$2"
          shift
          shift
        else
          printf "%s\n" "--timezone requires an argument: --timezone, -t TIMEZONE" >&2
          exit 1
        fi
        ;;

      --lvm-device | -d)

        if [[ -n ${2+x} ]]; then
          args['--lvm-device']="$2"
          shift
          shift
        else
          printf "%s\n" "--lvm-device requires an argument: --lvm-device, -d PATH" >&2
          exit 1
        fi
        ;;

      --extras | -x)

        args['--extras']=1
        shift
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  if [[ -v args['--ssh-port'] ]]; then
    validation_output="$(validate_port "${args['--ssh-port']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--ssh-port, -p PORT" "$validation_output" >&2
      exit 1
    fi
  fi

}

