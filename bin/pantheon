pantheon_usage() {
  printf "pantheon - 🏛️ Pantheon CLI: a minimal, configurable baseline for a headless Ubuntu Server\n\n"

  printf "%s\n" "Usage:"
  printf "  pantheon COMMAND\n"
  printf "  pantheon [COMMAND] --help | -h\n"
  printf "  pantheon --version | -v\n"
  echo

  printf "%s\n" "Commands:"
  printf "  %s   Prepare and secure the server\n" "setup      "
  printf "  %s   Install another Pantheon version from GitHub\n" "update     "
  printf "  %s   Put pantheon on your PATH, with bash completion\n" "install    "
  printf "  %s   Print the shell completion script for eval\n" "completions"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "--version, -v"
    printf "    Show version number\n"
    echo

  fi
}

